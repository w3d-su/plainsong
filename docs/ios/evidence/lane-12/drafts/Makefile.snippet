# ── proposed Makefile additions for lane 12 (applied only after 13→12 handoff) ──
#
# Rules (handoff 12 / contracts.md §1):
#  - PACKAGES (Mac swift test loop) is untouched: EditorKitIOS / WorkspaceKitIOS
#    must never enter it — UIKit packages cannot run on the macOS host.
#  - make build / test / release keep their exact current behavior; nothing here
#    makes them build iOS or touch devices.
#  - iOS lint coverage is added only for paths that exist (wildcard keeps the
#    pre-C0 tree lintable).

# iOS source dirs join lint only once C0 creates them.
SWIFT_FORMAT_PATHS := App AppTests Packages PerformanceTests PlainsongUITests Scripts \
    $(wildcard AppIOS AppIOSTests IOSAcceptanceTests)

IOS_OUTPUT_ROOT ?= /private/tmp/plainsong-ios-release

.PHONY: ios-build ios-test ios-archive ios-ipa

# IOS_DESTINATION must be a real installed simulator UUID, e.g.
#   make ios-test IOS_DESTINATION='platform=iOS Simulator,id=<installed-uuid>'
# When unset, Scripts/ios resolves the newest installed iOS>=26 iPhone simulator
# or fails early — device/simulator names are never guessed.
ios-build:
	Scripts/ios/run-ios-build.sh

ios-test:
	Scripts/ios/run-ios-tests.sh

ios-archive:
	Scripts/ios/run-ios-archive.sh "$(IOS_OUTPUT_ROOT)"

ios-ipa:
	Scripts/ios/run-ios-ipa.sh "$(IOS_OUTPUT_ROOT)"
